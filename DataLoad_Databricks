from pyspark.sql import functions as F

# 1. Setup paths and Authentication
accesskey = dbutils.secrets.get(scope='akv-adb-scope', key='adls-key')
adls, container = "itcbdneadls", "cat-training-bd-uk"
spark.conf.set(f"fs.azure.account.key.{adls}.dfs.core.windows.net", accesskey)

# Define Base Paths
# Ensure these paths match your ADLS structure exactly
base_input_path = f"abfss://{container}@{adls}.dfs.core.windows.net/sri/Insurance_Project/raw/"
base_output_path = f"abfss://{container}@{adls}.dfs.core.windows.net/sri/Insurance_Project/bronze/"

tables = ["customers", "payments", "claims", "policies"]

for table_name in tables:
    # A. Define Paths for this specific table
    raw_path = f"{base_input_path}{table_name}/"
    target_table = f"bronze_sri_{table_name}"
    target_folder = f"{base_output_path}{table_name}"
    
    # Metadata folders (Critical for Auto Loader to track progress and schema)
    schema_location = f"{target_folder}/_metadata/schema"
    checkpoint_location = f"{target_folder}/_metadata/checkpoint"

    print(f"Starting Incremental Load for: {table_name}")

    # B. Read with Auto Loader (cloudFiles)
    # This automatically ignores files it has already processed
    df = (spark.readStream.format("cloudFiles")
          .option("cloudFiles.format", "csv")
          .option("header", "true")
          .option("cloudFiles.schemaLocation", schema_location)
          .option("cloudFiles.inferColumnTypes", "true")
          .load(raw_path))

    # C. Write to Delta Bronze Layer
    query = (df.withColumn("_ingested_at", F.current_timestamp())
       .writeStream
       .format("delta")
       .outputMode("append")
       .option("checkpointLocation", checkpoint_location)
       .option("path", target_folder)
       # MergeSchema allows the Delta table to update if you add columns in Postgres
       .option("mergeSchema", "true") 
       # availableNow processes all new files and then stops (perfect for ADF)
       .trigger(availableNow=True) 
       .toTable(target_table))
    
    # Wait for the table to finish before moving to the next one in the loop
    query.awaitTermination()
    
    print(f"SUCCESS: {target_table} updated at {target_folder}")

print("ALL TABLES PROCESSED SUCCESSFULLY")
