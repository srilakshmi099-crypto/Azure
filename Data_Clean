from pyspark.sql import functions as F
from delta.tables import DeltaTable

# 1. Setup Paths
adls, container = "itcbdneadls", "cat-training-bd-uk"
base_silver_path = f"abfss://{container}@{adls}.dfs.core.windows.net/sri/Insurance_Project/silver/"

# 2. Define Table Names
tables = ["customers", "payments", "claims", "policies"]

for table_name in tables:
    print(f"--- Processing Silver: {table_name} ---")
    
    # Read the latest data from Bronze
    df = spark.table(f"bronze_sri_{table_name}")
    
    # --- A. Global Cleaning ---
    # Identify the Primary Key for MERGE
    primary_key = df.columns[0]
    df = df.dropDuplicates([primary_key])
    
    # --- B. Table-Specific Logic ---
    if table_name == "customers":
        df = df.fillna({"city": "UNKNOWN", "occupation": "UNKNOWN"}) \
               .filter((F.col("age") >= 18) & (F.col("age") <= 100)) \
               .withColumn("customer_id", F.regexp_replace(F.col("customer_id"), "C", "").cast("int"))
               
    elif table_name == "policies":
        df = df.withColumn("customer_id", F.regexp_replace(F.col("customer_id"), "C", "").cast("int")) \
               .withColumn("start_date", F.to_date("start_date")) \
               .withColumn("end_date", F.to_date("end_date")) \
               .filter(F.col("premium_amount") > 0)
               
    elif table_name == "claims":
        df = df.fillna({"incident_type": "UNKNOWN", "fraud_flag": 0}) \
               .withColumn("claim_date", F.to_date("claim_date")) \
               .filter(F.col("claim_amount") > 0)
               
    elif table_name == "payments":
        df = df.withColumn("payment_date", F.to_date("payment_date")) \
               .filter(F.col("payment_amount") >= 0)

    # --- C. Final Metadata & Write Logic ---
    target_table = f"silver_sri_{table_name}"
    target_path = f"{base_silver_path}{table_name}"
    
    # Add audit column
    df_final = df.withColumn("_silver_at", F.current_timestamp())

    # --- D. THE FIX: Handle Initial vs Incremental Load ---
    # isDeltaTable checks if the _delta_log folder exists at the physical path
    if DeltaTable.isDeltaTable(spark, target_path):
        print(f"Incremental Load: Merging into {target_table}...")
        silverTable = DeltaTable.forPath(spark, target_path)
        
        silverTable.alias("target").merge(
            df_final.alias("source"),
            f"target.{primary_key} = source.{primary_key}"
        ).whenMatchedUpdateAll() \
         .whenNotMatchedInsertAll() \
         .execute()
    else:
        print(f"Initial Load: Creating table {target_table} at {target_path}...")
        # Use overwrite mode to initialize the folder as a proper Delta table
        (df_final.write.format("delta")
           .mode("overwrite") 
           .option("path", target_path)
           .saveAsTable(target_table))

    print(f"SUCCESS: {target_table} processed.")

print("--- Silver Layer Load Complete ---")
